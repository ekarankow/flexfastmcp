# OpenAPI Specification Configuration
# Source type: 'file' for local files, 'url' for remote specs
OPENAPI_SPEC_SOURCE=file

# Location of the OpenAPI spec (file path or URL)
# Examples:
# - Local file: ./openapi.json or ./openapispec/openapi.json
# - URL: https://api.example.com/openapi.json
OPENAPI_SPEC_LOCATION=./openapi.json

# API Configuration
# Base URL of the API you're connecting to
API_BASE_URL=https://api.example.com

# Base URL Override (optional)
# If set, this will override the base URL in all OpenAPI specs
# Useful for testing against local or staging environments
# Examples:
# - Local development: http://localhost:8080
# - Staging: https://staging-api.example.com
# BASE_URL=http://localhost:8080

# Authentication (optional)
# Bearer token for Authorization header
API_AUTH_TOKEN=your-bearer-token-here

# API Key for X-API-Key header
API_KEY=your-api-key-here

# Request timeout in seconds
API_TIMEOUT=30.0

# MCP Server Configuration
# Name for your MCP server
MCP_SERVER_NAME=OpenAPI MCP Server

# Port for MCP server (used in docker-compose)
MCP_PORT=3000

# MCP Cache Configuration
# Maximum number of cached MCP instances (0 = unlimited)
MCP_CACHE_MAX_SIZE=100

# Time-to-live for cached entries in seconds (0 = no expiry)
MCP_CACHE_TTL=3600

# Interval for cleanup task in seconds
MCP_CACHE_CLEANUP_INTERVAL=300